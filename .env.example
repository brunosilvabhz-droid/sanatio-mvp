APP_PUBLIC_URL=https://sanatio.exemplo.com
SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
INITIAL_ADMIN_PASSWORD=defina-uma-senha-inicial-forte

# Brevo SMTP relay. Use a chave SMTP da Brevo, nunca a senha da conta.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=seu-login-smtp-brevo
SMTP_PASSWORD=sua-chave-smtp-brevo
SMTP_FROM_EMAIL=sanatio@seu-dominio.com
SMTP_FROM_NAME=SANATIO
SMTP_USE_TLS=true

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ALERT_EMAIL_ENABLED=true
ALERT_NOTIFICATION_ROLES=SCIH,INFECTO
# Destinatarios adicionais separados por virgula.
ALERT_NOTIFICATION_EMAILS=
